# Copy to .env.local. Supply your own credentials; leave unused settings blank.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PAPER_SEARCH_PYTHON=/absolute/path/to/.research-deps/bin/python
# METHODATLAS_PORT=8765

# Optional multi-user mode. Empty AUTH_URL keeps the local personal mode.
METHODATLAS_AUTH_URL=
METHODATLAS_AUTH_ANON_KEY=
METHODATLAS_PUBLIC_URL=
# METHODATLAS_LEGACY_OWNER_EMAIL=
# METHODATLAS_MAX_PARALLEL_RUNS=2

# Optional project invitation/notification mail; configure Auth mail separately.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=implicit_tls
SMTP_USER=
SMTP_PASSWORD=
